&spi3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi3m1_pins &spi3m1_cs0>;

	spidev@0 {
		// switch compatible spidev or subucom_spi
		//compatible = "rockchip,spidev";
		compatible = "alphatheta,subucom_spi";
		reg = <0>;
		spi-max-frequency = <3200000>;

		// Remove comment lines in case of subucom.
		spi-cpha = <1>;
		spi-cpol = <1>;
		pinctrl-0 = <&subucom_spi3>;
		req-gpio = <&gpio0 RK_PC3 GPIO_ACTIVE_HIGH>;	/* req:  GPIO0 C3 */
		cont-gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;	/* cont: GPIO0 A6 */
	};
};

// Remove comment lines in case of subucom.
&pinctrl {
	/* atc: enable subucom_spi driver */
	subucom-spi {
		subucom_spi3: subucom-spi3 {
			rockchip,pins =
				<4 RK_PC4 RK_FUNC_GPIO &pcfg_pull_down>,	/* SoM_ErP_REQ:  GPIO4 C4 */
				<0 RK_PA6 RK_FUNC_GPIO &pcfg_output_low>;	/* SoM_ErP_CONT: GPIO0 A6 */
		};
	};
};

&sata1 {
	status = "disabled";	//"okay";	//open this, usb3.0 will not work,sata work
};

