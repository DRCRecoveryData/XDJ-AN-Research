&rkcif {
	status = "disabled";	// "okay";
};

&rkcif_dvp {
	status = "disabled";

	port {
		//Parallel bus endpoint
		dvp_in_bcam: endpoint {
			//remote-endpoint = <&gc2145_out>;
			bus-width = <8>;
			vsync-active = <0>;
			hsync-active = <1>;
		};
	};
};

&rkcif_mipi_lvds {
	status = "disabled";	// "okay";

	port {
		cif_mipi_in: endpoint {
			remote-endpoint = <&mipi_csi2_output>;
			data-lanes = <1 2>;
		};
	};
};

&rkcif_mmu {
	status = "disabled";	// "okay";
};

&rkisp {
	status = "disabled";	// "okay";
};

&rkisp_mmu {
	status = "disabled";	// "okay";
};

&rkisp_vir0 {
	status = "disabled";	// "okay";

	port {
		#address-cells = <1>;
		#size-cells = <0>;

		isp0_in: endpoint@0 {
			reg = <0>;
			remote-endpoint = <&dphy1_out>;
		};
	};
};

&sdmmc2 {
	status = "disabled";
};

// for Silex SDMAX wireless LAN via SDIO
&sdmmc1 {
	max-frequency = <150000000>;
//	supports-sd;
	supports-sdio;
	bus-width = <4>;
//	cap-mmc-highspeed;
	cap-sd-highspeed;
	cap-sdio-irq;
	disable-wp;
	non-removable;
	sd-uhs-sdr104;
	keep-power-in-suspend;
	mmc-pwrseq = <&sdio_pwrseq>;
	pinctrl-names = "default";
//	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk &sdmmc1_det>;
	pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk>;
	status = "okay";
};

&sdio_pwrseq {
	compatible = "mmc-pwrseq-simple";
	pinctrl-names = "default";
	pinctrl-0 = <&wm_rst>;

	post-power-on-delay-ms = <200>;
	reset-gpios = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
};

&spdif_8ch {
	status = "disabled";	// "okay";
//	pinctrl-names = "default";
//	pinctrl-0 = <&spdifm2_tx>;	//<&spdifm1_tx>;
};

&uart1 {
	status = "disabled";	// "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn>;
//	pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn &uart1m0_rtsn>;
};

// for EP169 RTX SonicLink via uart
&uart3 {
	status = "okay";
	dma-names = "tx", "rx";
	pinctrl-names = "default";
	pinctrl-0 = <&uart3m0_xfer>;
};

&uart4 {
	status = "disabled";	// "okay";
//	pinctrl-names = "default";
//	pinctrl-0 = <&uart4m0_xfer>;
};

// for Silex SDMAX bluetooth via uart
&uart5 {
	status = "okay";
	dma-names = "tx", "rx";
	pinctrl-names = "default";
	pinctrl-0 = <&uart5m0_xfer &uart5m0_ctsn &uart5m0_rtsn>;
};


&i2c4 {
	status = "okay";
	pinctrl-0 = <&i2c4m0_xfer>;

	clock-frequency = <400000>;

	// for EP169 touch screen
	ili2130: ili2130@41 {
		status = "okay";
		compatible = "ilitek,ili2130";
		reg = <0x41>;

		pinctrl-names = "default";
		pinctrl-0 = <&touch_gpio2>;
		alphatheta,irq-gpios = <&gpio3 RK_PA2 GPIO_ACTIVE_LOW>;	// TOUCH_INT
		reset-gpios = <&gpio0 RK_PC4 GPIO_ACTIVE_LOW>;			// TOUCH_RST
	};

