&video_phy0 {
	status = "okay";
};

&video_phy1 {
	status = "disabled";
};


&gmac1 {
	status = "okay";

	// RMII
	phy-mode = "rmii";
	clock_in_out = "output";

	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RMII_SPEED>;
	assigned-clock-rates = <0>, <50000000>;

	snps,reset-gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;	// <&gpio4 RK_PC2 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	/* Reset time is 20ms, 100ms for rtl8211f */
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac1m0_miim
		     &gmac1m0_clkinout
		     &gmac1m0_rx_bus2
		     &gmac1m0_tx_bus2
		     &gmac1m0_rx_er>;

	phy-handle = <&rmii_phy1>;

/*	// RGMII
	phy-mode = "rgmii";
	clock_in_out = "input";

	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>, <&gmac1_clkin>;

	snps,reset-gpio = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;	// <&gpio4 RK_PC2 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	// Reset time is 20ms, 100ms for rtl8211f
	snps,reset-delays-us = <0 20000 100000>;

	pinctrl-names = "default";
	pinctrl-0 = <&gmac1m0_miim
		     &gmac1m0_tx_bus2
		     &gmac1m0_rx_bus2
		     &gmac1m0_rgmii_clk
		     &gmac1m0_rgmii_bus
		     &gmac1m0_clkinout>;

	tx_delay = <0x4e>;	//<0x4f>;
	rx_delay = <0x2c>;	//<0x25>;

	phy-handle = <&rgmii_phy1>;
*/
};

&mdio1 {
	// RMII
	rmii_phy1: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
	};

/*	// RGMII
	rgmii_phy1: phy@0 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x0>;
	};
*/
};

&mipi_csi2 {
	status = "disabled";	//"okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_input: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&dphy2_out>;
				data-lanes = <1 2>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			mipi_csi2_output: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&cif_mipi_in>;
				data-lanes = <1 2>;
			};
		};
	};
};

&pcie2x1 {
//	reset-gpios = <&gpio1 RK_PB2 GPIO_ACTIVE_HIGH>;
//	vpcie3v3-supply = <&vcc3v3_pcie>;
	status = "disabled";	//"okay";
};

&pinctrl {
	// for touch screen
	touch2 {
		touch_gpio2: touch-gpio2 {
			rockchip,pins =
				<3 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>,	// TOUCH_INT
				<0 RK_PC4 RK_FUNC_GPIO &pcfg_pull_none>;	// TOUCH_RST
		};
	};

	// for wifi/bluetooth module PDN
	sdio-pwrseq {
		wm_rst: wm-rst {
			rockchip,pins = <2 RK_PB5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	// for EP169 USB-C host from CDJ-3000X
	extcon {
		atc_usb_gpios: atc-usb-gpios {
			rockchip,pins =
				<0 RK_PA4 RK_FUNC_GPIO &pcfg_output_low>,	/* USBC_PE (out): GPIO0_A4 */
				<1 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>,	/* USBC_OC (in) : GPIO1_D6 */
				<0 RK_PC2 RK_FUNC_GPIO &pcfg_pull_none>,	/* SNKDET_B(in) : GPIO0_C2 */
				<3 RK_PA4 RK_FUNC_GPIO &pcfg_output_low>,	/* USBC_PE2(out): GPIO3_A4 */
				<3 RK_PA5 RK_FUNC_GPIO &pcfg_output_low>;	/* USBC_DSC(out): GPIO3_A5 */
		};
	};

