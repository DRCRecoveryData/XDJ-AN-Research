//		vin-supply = <&dc_12v>;
//	};

	gpio-controller {
		compatible = "gpio_control";
		//host_pwr = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>;		//Host power
//		usb30_pwr = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;		//usb30 power	VCC5V0_HOST1 (eva)
		//pcie_pwr = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;		//pcie power
		//logic_fb = <&gpio0 RK_PC0 GPIO_ACTIVE_LOW>;		//logic fb
//		rst_4g = <&gpio0 RK_PA0 GPIO_ACTIVE_HIGH>;		//rst_4g
//		sdcd_xrst = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;	// TODO:
		status = "disabled";	// "okay";
	};

	// for EP169 USB-C host from CDJ-3000X
	atc_usb_gpio_extcon: atc-usb-gpio-extcon {
		status = "okay";
		compatible = "alphatheta,extcon-atc-usb-gpio";
		pinctrl-names = "default";
		pinctrl-0 = <&atc_usb_gpios>;

		usbc-pe-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_HIGH>;		/* USBC_PE (out): GPIO0_A4 */
		usbc-oc-gpios = <&gpio1 RK_PD6 GPIO_ACTIVE_LOW>;		/* USBC_OC (in) : GPIO1_D6 */
		snkdet-b-gpios = <&gpio0 RK_PC2 GPIO_ACTIVE_LOW>;		/* SNKDET_B(in) : GPIO0_C2 */
		usbc-pe2-gpios = <&gpio3 RK_PA4 GPIO_ACTIVE_HIGH>;		/* USBC_PE2(out): GPIO3_A4 */
		usbc-dsc-gpios = <&gpio3 RK_PA5 GPIO_ACTIVE_HIGH>;		/* USBC_DSC(out): GPIO3_A5 */
	};
};

&combphy1_usq {
	status = "okay";
};

&combphy2_psq {
	status = "okay";
};

&csi2_dphy_hw {
	status = "disabled";	//"okay";
};

&csi2_dphy0 {
	status = "disabled";
	/*
	 * dphy0 only used for full mode,
	 * full mode and split mode are mutually exclusive
	 */
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			dphy0_in: endpoint@1 {
				reg = <1>;
				//remote-endpoint = <&gc8034_out>;
				data-lanes = <1 2 3 4>;
			};
		};
/*
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			dphy0_out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&isp0_in>;
			};
		};
*/
	};
};

&csi2_dphy1 {
	status = "disabled";	//"okay";

	/*
	 * dphy1 only used for split mode,
	 * can be used  concurrently  with dphy2
	 * full mode and split mode are mutually exclusive
	 */
	ports {
		#address-cells = <1>;
		#size-cells = <0>;
/*
		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			dphy1_in: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&ucam_out0>;		//<&ov5695_out>;
				data-lanes = <1 2>;
			};
		};
*/
		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			dphy1_out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&isp0_in>;
			};
		};
	};
};

&csi2_dphy2 {
	status = "disabled";	//"okay";

	/*
	 * dphy2 only used for split mode,
	 * can be used  concurrently  with dphy1
	 * full mode and split mode are mutually exclusive
	 */
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			dphy2_in: endpoint@1 {
				reg = <1>;
				//remote-endpoint = <&ucam_out1>;	//<&gc5025_out>;
				data-lanes = <1 2>;
			};
		};

		port@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			dphy2_out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&mipi_csi2_input>;
			};
		};
	};
};

&hdmi {
	status = "disabled";	//"okay";
	rockchip,phy-table =
		<92812500  0x8009 0x0000 0x0270>,
		<165000000 0x800b 0x0000 0x026d>,
		<185625000 0x800b 0x0000 0x01ed>,
		<297000000 0x800b 0x0000 0x01ad>,
		<594000000 0x8029 0x0000 0x0088>,
		<000000000 0x0000 0x0000 0x0000>;
};

&hdmi_in_vp0 {
	status = "disabled";	//"okay";
};

&hdmi_in_vp1 {
	status = "disabled";
};

&route_hdmi {
	status = "disabled";	//"okay";
	connect = <&vp0_out_hdmi>;
};

&hdmi_sound {
	status = "disabled";	//"okay";
};

/*
 * video_phy0 needs to be enabled
 * when dsi0 is enabled
 */
&dsi0 {
	status = "disabled";
};

&route_dsi0 {
	status = "disabled";
	connect = <&vp1_out_dsi0>;
};

&dsi0_in_vp0 {
	status = "disabled";
};

&dsi0_in_vp1 {
	status = "disabled";
};

